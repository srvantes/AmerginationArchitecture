# Copy to .env.production on the server. Never commit real credentials.
# Run with: docker compose --env-file .env.production -f compose.production.yaml ...
COMPOSE_PROJECT_NAME=amergination
APP_IMAGE=amergination-app:local

# Canonical hostname only: no https://, slash, path, or port.
# Configure its DNS A record to the VPS before requesting a public certificate.
SITE_DOMAIN=amergination.com
PUBLIC_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_USER=amergination
POSTGRES_DB=amergination
# Required. Generate a random password; do not reuse development credentials.
POSTGRES_PASSWORD=
# Required, at least 32 random characters. Example generation command:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SMTP is required for signup confirmation and password recovery.
# Gmail requires a Google app password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=10
EMAIL_SEND_LIMIT_PER_HOUR=5

# Optional own Kodik key. With this empty, the official public integration is used.
# KODIK_SITE_URL and APP_HOST are derived from SITE_DOMAIN by production Compose.
KODIK_TOKEN=

EXTERNAL_SERVICE_TIMEOUT_SECONDS=20
EXTERNAL_CONNECT_TIMEOUT_SECONDS=3
EXTERNAL_READ_TIMEOUT_SECONDS=5
EXTERNAL_SERVICE_ATTEMPTS=2
EXTERNAL_RETRY_MAX_DELAY_SECONDS=2
REGISTRATION_LIMIT_PER_HOUR=3
LOGIN_LIMIT_PER_5_MINUTES=30
LOGIN_ACCOUNT_LIMIT_PER_5_MINUTES=10
COMMENT_LIMIT_PER_HOUR=20
COMMENT_COOLDOWN_SECONDS=15
LIKE_LIMIT_PER_MINUTE=30
DISCUSSION_EDIT_LIMIT_PER_MINUTE=30
REVIEW_LIMIT_PER_HOUR=5
CATALOG_LIMIT_PER_MINUTE=120
